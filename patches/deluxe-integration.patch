+procedure UpdateDrawableMetrics();
+var
+  W, H, LogicalW, LogicalH: integer;
+begin
+  W := 0;
+  H := 0;
+  if Screen <> nil then
+  begin
+    SDL_GetWindowSize(Screen, @LogicalW, @LogicalH);
+    // The OS may constrain an oversized window without a usable resize event.
+    // Query both dimensions from SDL, never infer logical size from a DPI guess.
+    if (LogicalW > 0) and (LogicalH > 0) and
+       ((LogicalW <> ScreenW) or (LogicalH <> ScreenH)) then
+    begin
+      ScreenW := LogicalW;
+      ScreenH := LogicalH;
+      CalculateScreenMetrics;
+    end;
+    SDL_GL_GetDrawableSize(Screen, @W, @H);
+  end;
+  // A minimized window can temporarily have no drawable. Keep valid metrics.
+  if (W <= 0) or (H <= 0) then
+  begin
+    W := Max(1, ScreenW);
+    H := Max(1, ScreenH);
+  end;
+  DrawableW := W;
+  DrawableH := H;
+  DrawableScaleX := DrawableW / Max(1, ScreenW);
+  DrawableScaleY := DrawableH / Max(1, ScreenH);
+end;
+
 procedure CalculateScreenMetrics();
 begin
   ScreenWPerScreen := ScreenW div Screens;
