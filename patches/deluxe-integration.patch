@@ -110,6 +110,7 @@   TSongs = class(TThread)
     constructor Create();
     destructor  Destroy(); override;
 
+    function ShellImport(const FilePath: IPath): boolean;
     procedure LoadSongList;     // load all songs
   procedure FindFilesByExtension(const Dir: IPath; const Ext: IPath; Recursive: Boolean; var Files: TPathDynArray);
     procedure Sort(Order: TSortingType);
@@ -343,6 +344,23 @@ procedure TSongs.int_LoadSongList;
 end;
 
 
+function TSongs.ShellImport(const FilePath: IPath): boolean;
+var I: integer; Candidate, PreviousSong: TSong;
+begin
+  Result:=false;
+  if not FilePath.IsFile then Exit;
+  for I:=0 to SongList.Count-1 do
+    if TSong(SongList[I]).Path.Append(TSong(SongList[I]).FileName).ToNative = FilePath.ToNative then Exit;
+  PreviousSong:=CurrentSong;
+  Candidate:=TSong.Create(FilePath);
+  try
+    if not Candidate.Analyse(false,false,false,false,0,true) then Exit;
+    if not Candidate.Audio.IsSet then Exit;
+    if not Candidate.Path.Append(Candidate.Audio).IsFile then Exit;
+    SongList.Add(Candidate); Candidate:=nil; Result:=true;
+  finally CurrentSong:=PreviousSong; Candidate.Free; end;
+end;
+
 procedure TSongs.LoadSongList;
 begin
   fParseSongDirectory := true;
