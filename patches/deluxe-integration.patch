+# Every attempt must pass the pinned source hash; never cache an HTTP error page.
+fetch_verified() {
+    local download_url="$1" download_target="$2" download_hash="$3"
+    local attempt actual_hash
+    for attempt in 1 2 3 4; do
+        if curl --fail --show-error --silent --location --retry 2 --retry-all-errors \
+            --connect-timeout 20 --max-time 180 "$download_url" -o "$download_target.tmp"; then
+            actual_hash="$(sha256sum "$download_target.tmp" | awk '{print $1}')"
+            if [ "$actual_hash" = "$download_hash" ]; then
+                mv "$download_target.tmp" "$download_target"
+                return 0
+            fi
+            echo "Source hash mismatch on attempt $attempt for $download_url" >&2
+        fi
+        rm -f "$download_target.tmp"
+        sleep "$attempt"
+    done
+    echo "Could not obtain verified source: $download_url" >&2
+    return 1
+}
