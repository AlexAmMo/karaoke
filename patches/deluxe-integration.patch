+          Monitor[i]:=Round(PSmallIntArray(Buffer)^[Offset+i]*fMonitorCurrentGain);
+          MonitorPeak:=Max(MonitorPeak,Abs(integer(Monitor[i])));
+        end;
+        fVoiceStream.WriteData(@Monitor[0],Count*2);
+        Inc(Offset,Count);
+      end;
+    end;
