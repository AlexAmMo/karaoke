diff --git a/src/base/URecord.pas b/src/base/URecord.pas
index ea54f6b..c0384cd 100644
--- a/src/base/URecord.pas
+++ b/src/base/URecord.pas
@@ -59,6 +59,7 @@ interface
 
   TCaptureBuffer = class
     private
+      fMonitorCurrentGain: single;
       fVoiceStream: TAudioVoiceStream; // stream for voice passthrough
       fAnalysisBufferLock: PSDL_Mutex;
       fAudioFormat: TAudioFormatInfo;
@@ -80,6 +81,12 @@   TCaptureBuffer = class
       function AverageMagnitudeDifference(): TCorrelationArray;
       function CircularAverageMagnitudeDifference(): TCorrelationArray;
       function ArrayIndexOfMinimum(const AValues: array of real): Integer;
+    public
+      MonitorGain: single; // monitoring only; zero by default, independent of pitch input
+      MonitorPeak: integer;
+      procedure TestStart(Format: TAudioFormatInfo);
+      procedure TestStop;
+      procedure TestFeed(Buffer: PByteArray; Size: integer);
     public
       AnalysisBuffer:  array[0..4095] of smallint; // newest 4096 samples (MUST BE POWER OF TWO!)
       AnalysisBufferSize: integer; // number of samples of BufferArray to analyze
@@ -307,18 +314,46 @@ procedure TCaptureBuffer.Clear;
   UnlockAnalysisBuffer();
 end;
 
+procedure TCaptureBuffer.TestStart(Format: TAudioFormatInfo);
+begin StartCapture(Format); end;
+procedure TCaptureBuffer.TestStop;
+begin StopCapture; end;
+procedure TCaptureBuffer.TestFeed(Buffer: PByteArray; Size: integer);
+begin ProcessNewBuffer(Buffer,Size); end;
+
 procedure TCaptureBuffer.ProcessNewBuffer(Buffer: PByteArray; BufferSize: integer);
 var
   BufferOffset: integer;
   SampleCount:  integer;
-  i:            integer;
+  i, Offset, Count: integer;
+  Monitor: array[0..4095] of SmallInt;
+  Gain: single;
 begin
   // apply software boost
   BoostBuffer(Buffer, BufferSize);
 
   // voice passthrough (send data to playback-device)
   if (assigned(fVoiceStream)) then
-    fVoiceStream.WriteData(Buffer, BufferSize);
+  begin
+    begin
+      // Copy only the monitoring branch; never scale the pitch-analysis input.
+      Gain:=EnsureRange(MonitorGain,0.0,1.0); Offset:=0; MonitorPeak:=0;
+      while Offset < BufferSize div 2 do
+      begin
+        Count:=Min(4096,BufferSize div 2-Offset);
+        for i:=0 to Count-1 do
+        begin
+          // Ramp only the output copy over about 5 ms at 48 kHz; pitch input is untouched.
+          if fMonitorCurrentGain<Gain then fMonitorCurrentGain:=Min(Gain,fMonitorCurrentGain+1/240)
+          else if fMonitorCurrentGain>Gain then fMonitorCurrentGain:=Max(Gain,fMonitorCurrentGain-1/240);
+          Monitor[i]:=Round(PSmallIntArray(Buffer)^[Offset+i]*fMonitorCurrentGain);
+          MonitorPeak:=Max(MonitorPeak,Abs(integer(Monitor[i])));
+        end;
+        fVoiceStream.WriteData(@Monitor[0],Count*2);
+        Inc(Offset,Count);
+      end;
+    end;
+  end;
 
   // we assume that samples are in S16Int format
   // TODO: support float too
